# Used by docker/docker-compose.yml. Copy to docker/.env (or export in your
# shell) before running `npm run docker:up`. Individual apps also have their
# own .env.example files (apps/api/.env.example, apps/web/.env.example) for
# running outside Docker.

# --- PostgreSQL ---
POSTGRES_USER=cca_user
POSTGRES_PASSWORD=cca_password
POSTGRES_DB=cca_platform
POSTGRES_PORT=5432

# --- API ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Nginx (optional profile: docker compose --profile with-nginx up) ---
NGINX_PORT=8080
